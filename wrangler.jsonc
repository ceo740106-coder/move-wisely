{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "move-wisely",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "ratelimits": [
    {
      "name": "MOVEWISELY_EDGE_LIMITER",
      "namespace_id": "51001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
