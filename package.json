{
  "name": "move-wisely",
  "version": "5.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 8081",
    "deploy": "npm run verify && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test src/lib/chess/*.test.ts && node --test scripts/brand-check.test.mjs",
    "brand:check": "node scripts/brand-check.mjs",
    "cf-typegen": "wrangler types",
    "format": "prettier --write .",
    "verify": "npm run brand:check && npm run lint && npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@vitejs/plugin-react": "5.2.0",
    "chess.js": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.510.0",
    "stockfish": "19.0.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.3.0",
    "zustand": "5.0.0",
    "zod": "4.4.0",
    "@tanstack/start-server-core": "1.169.39"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.0",
    "@eslint/js": "9.20.0",
    "@types/node": "22.16.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "9.20.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-prettier": "5.2.6",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "15.15.0",
    "prettier": "3.4.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.56.1",
    "vite": "8.3.2",
    "wrangler": "4.143.0"
  },
  "description": "Competition-focused chess analysis and preparation built from a player's own games.",
  "keywords": [
    "chess",
    "training",
    "stockfish",
    "competition",
    "analysis",
    "supabase",
    "cloudflare"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
